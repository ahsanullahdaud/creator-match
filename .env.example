# Copy to .env.local for local development. Never commit .env.local.

# Claude
ANTHROPIC_API_KEY=

# YouTube Data API v3. Restrict the key to that API in Google Cloud.
YOUTUBE_API_KEY=

# Upstash Redis, injected by the Vercel Marketplace integration.
# Leave both unset locally to use the in-memory cache.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. A visitor who enters this passcode bypasses the per-visitor search limit.
DEMO_PASSCODE=

# Random string mixed into visitor IP hashes.
RATE_LIMIT_SALT=change-me

# Models
CLAUDE_QUERY_MODEL=claude-haiku-4-5
CLAUDE_SCORE_MODEL=claude-sonnet-5-5

# Tuning. These are the defaults from src/lib/config.ts.
SCORE_CONCURRENCY=5
CLAUDE_MAX_RETRIES=3
CLAUDE_TIMEOUT_MS=30000
VISITOR_SEARCH_LIMIT=3
YT_PUBLIC_SEARCH_BUDGET=60
YT_TOTAL_SEARCH_BUDGET=95
