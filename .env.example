# Copy to .env.local for local development. Never commit .env.local.

# Gemini API key from Google AI Studio (free tier, no billing attached).
GEMINI_API_KEY=

# YouTube Data API v3. Restrict the key to that API in Google Cloud.
YOUTUBE_API_KEY=

# Upstash Redis, injected by the Vercel Marketplace integration.
# Leave both unset locally to use the in-memory cache.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. A visitor who enters this passcode bypasses the per-visitor search limit.
DEMO_PASSCODE=

# Random string mixed into visitor IP hashes.
RATE_LIMIT_SALT=change-me

# LLM provider and models. Ids live here, never in code. Avoid "-latest" aliases.
LLM_PROVIDER=gemini
LLM_QUERY_MODEL=gemini-3.5-flash-lite
LLM_SCORE_MODEL=gemini-3.5-flash-lite

# LLM tuning. These are the defaults from src/lib/config.ts.
# Free-tier requests per minute and per day are shown at aistudio.google.com/rate-limit.
LLM_CONCURRENCY=2
LLM_SCORE_BATCH_SIZE=5
LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=30000
LLM_DAILY_REQUEST_BUDGET=450

# Visitor and YouTube limits. Defaults from src/lib/config.ts.
VISITOR_SEARCH_LIMIT=3
YT_PUBLIC_SEARCH_BUDGET=60
YT_TOTAL_SEARCH_BUDGET=95
